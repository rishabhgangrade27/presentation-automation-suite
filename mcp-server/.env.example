# Base URL of the running n8n instance that hosts the Presenton generation workflow.
# Port 5679 (not the n8n default 5678) so this project's n8n never collides with
# another n8n instance you might already have running.
N8N_BASE_URL=http://localhost:5679

# Webhook paths inside that n8n workflow (match n8n/presenton-generation-workflow.json).
N8N_GENERATE_PATH=/webhook/presenton/generate
N8N_STATUS_PATH_PREFIX=/webhook/presenton/status

# Polling behaviour for generate_presentation(wait_for_completion=true).
POLL_INTERVAL_MS=5000
MAX_WAIT_MS=300000

# Port for the Streamable HTTP transport (src/http.ts). Not used by the stdio transport.
PORT=8787
