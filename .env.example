# Host port n8n will be published on (kept off the 5678 default to avoid
# colliding with any other n8n instance already running on this machine).
N8N_HOST_PORT=5679

# Where n8n's HTTP Request nodes reach the Presenton container.
# host.docker.internal works when n8n runs in Docker (this compose file) and
# Presenton is a separate Docker container publishing port 5001 on the host.
PRESENTON_BASE_URL=http://host.docker.internal:5001

TZ=Asia/Kolkata
