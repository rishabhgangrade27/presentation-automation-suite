# Base URL of the n8n instance hosting the Presenton generation workflow
# (started natively with n8n/run_native.sh -- see the root README).
N8N_BASE_URL=http://localhost:5678

# Optional: set this to call Presenton's REST API directly instead of going
# through n8n (used during isolated frontend development/testing while n8n
# was unavailable). When set, this takes priority over N8N_BASE_URL and
# bypasses the n8n workflow entirely.
# PRESENTON_BASE_URL=http://127.0.0.1:8000
